{
  // Configuração do Worker (Cloudflare Workers + Static Assets).
  // Migrado de Cloudflare Pages -> Workers.
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "conteudoextremo",
  "compatibility_date": "2024-12-01",

  // Entrada do Worker: serve /api/* (Hono) e delega o resto para os assets.
  "main": "worker.js",

  // Site estático (build do Vite em ./dist). O not_found_handling = SPA
  // devolve index.html para rotas do app (ex.: /dashboard), preservando a URL.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // KV (mesmos namespaces criados na conta Universo Extremo):
  //   content_hub_kv          (produção)
  //   content_hub_kv_preview  (preview)
  "kv_namespaces": [
    {
      "binding": "CONTENT_HUB_KV",
      "id": "c8d63494eef74bd0b9748bc933b0bfc3",
      "preview_id": "494b41a38cce402baa748d9c552ba835"
    }
  ]

  // Variáveis de ambiente (ANTHROPIC_API_KEY, OPENAI_API_KEY, VITE_SUPABASE_*,
  // YOUTUBE_*, FACEBOOK_*, INSTAGRAM_*) NÃO vão aqui — configure em:
  //   Workers & Pages > (projeto) > Settings > Variables and Secrets
  // Para dev local, use .dev.vars (veja .dev.vars.example).
}
